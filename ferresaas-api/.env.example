# Database
# Migraciones/seed usan el usuario admin; la API runtime usa ferresaas_runtime
# (rol sin superuser/RLS-bypass, creado por docker/postgres-init).
DATABASE_URL="postgresql://user:password@localhost:5432/ferresaas"
# URL de runtime con el rol limitado (RLS aplica):
DATABASE_RUNTIME_URL="postgresql://ferresaas_runtime:runtime_dev_password@localhost:5432/ferresaas"

# JWT
JWT_ACCESS_SECRET="your-access-secret-min-32-chars-change-this-in-production"
JWT_ACCESS_EXPIRES_IN="15m"

# Redis: obligatorio en producción (rate limiting de auth y caché de permisos).
# En desarrollo puede estar deshabilitado; los limiters se saltan y la caché
# de permisos cae a PostgreSQL. Nunca simula revocación en memoria.
REDIS_URL="redis://localhost:6379"
REDIS_ENABLED="true"

# Email
# Valores: mock | smtp
# mock: loguea emails en consola (desarrollo)
# smtp: envía emails reales (producción)
EMAIL_PROVIDER="mock"
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"
EMAIL_FROM="noreply@ferresaas.com"

# Facturación ARCA
# Valores: mock | facturante | arca_direct
# mock: simula facturación sin credenciales (desarrollo)
# facturante: integración real con Facturante.com (producción)
# arca_direct: integración directa con ARCA/AFIP (en implementación)
INVOICE_PROVIDER="mock"
FACTURANTE_API_KEY="your-facturante-api-key"
FACTURANTE_API_URL="https://api.facturante.com/v1"
# ARCA directa (requiere Token + Sign vigentes de WSAA)
ARCA_CUIT="20123456789"
ARCA_TOKEN=""
ARCA_SIGN=""
ARCA_WSFE_URL="https://wswhomo.afip.gov.ar/wsfev1/service.asmx"
ARCA_WSAA_URL="https://wsaahomo.afip.gov.ar/ws/services/LoginCms"
# Binario OpenSSL para renovar Token/Sign por WSAA (default: openssl)
ARCA_OPENSSL_BIN="openssl"
# Ventana de renovación automática antes del vencimiento
ARCA_WSAA_REFRESH_MINUTES_BEFORE_EXPIRY="20"
# Clave usada para cifrar credenciales ARCA por tenant en DB
# (si no se define, usa JWT_ACCESS_SECRET como fallback)
ARCA_CREDENTIALS_SECRET=""
INVOICE_JOB_WORKER_ENABLED="true"
INVOICE_JOB_POLL_SECONDS="30"
INVOICE_JOB_MAX_ATTEMPTS="8"
INVOICE_JOB_BACKOFF_SECONDS="60"

# Tipo de cambio USD→ARS
EXCHANGE_RATE_PROVIDER="dolarapi"
EXCHANGE_RATE_FALLBACK_USD_ARS="1000"
EXCHANGE_RATE_CACHE_TTL_SECONDS="300"

# App
NODE_ENV="development"
PORT="3001"
FRONTEND_URL="http://localhost:3000"

# Logging
# Valores: trace | debug | info | warn | error | fatal
LOG_LEVEL="info"

# Sentry (opcional)
SENTRY_DSN=""

# Business Config
# Permitir stock negativo por defecto (true | false)
ALLOW_NEGATIVE_STOCK="false"

# Rate Limiting
RATE_LIMIT_WINDOW_MS="900000"
RATE_LIMIT_MAX_REQUESTS="100"

# Cookies (Seguridad)
# COOKIE_DOMAIN: opcional. Si se deja vacío/ausente la cookie queda host-only (recomendado en dev).
# Configurar el dominio real sólo si API y frontend comparten sitio y hace falta compartir cookie.
COOKIE_DOMAIN=""
# COOKIE_SECURE=true es OBLIGATORIO en producción: el arranque falla si es false con NODE_ENV=production.
COOKIE_SECURE="false"
COOKIE_SAME_SITE="strict"

# CSRF
CSRF_SECRET="your-csrf-secret-min-32-chars-change-this-in-production"
