# Database
DATABASE_URL="postgresql://user:password@localhost:5432/ferresaas"

# JWT
JWT_ACCESS_SECRET="your-access-secret-min-32-chars-change-this-in-production"
JWT_REFRESH_SECRET="your-refresh-secret-min-32-chars-change-this-in-production"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Redis (opcional - el sistema funciona sin Redis)
REDIS_URL="redis://localhost:6379"
REDIS_ENABLED="false"

# Email
# Valores: mock | smtp
# mock: loguea emails en consola (desarrollo)
# smtp: envía emails reales (producción)
EMAIL_PROVIDER="mock"
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"
EMAIL_FROM="noreply@ferresaas.com"

# Facturación ARCA
# Valores: mock | facturante | arca_direct
# mock: simula facturación sin credenciales (desarrollo)
# facturante: integración real con Facturante.com (producción)
# arca_direct: integración directa con ARCA/AFIP (en implementación)
INVOICE_PROVIDER="mock"
FACTURANTE_API_KEY="your-facturante-api-key"
FACTURANTE_API_URL="https://api.facturante.com/v1"
# ARCA directa (requiere Token + Sign vigentes de WSAA)
ARCA_CUIT="20123456789"
ARCA_TOKEN=""
ARCA_SIGN=""
ARCA_WSFE_URL="https://wswhomo.afip.gov.ar/wsfev1/service.asmx"
INVOICE_JOB_WORKER_ENABLED="true"
INVOICE_JOB_POLL_SECONDS="30"
INVOICE_JOB_MAX_ATTEMPTS="8"
INVOICE_JOB_BACKOFF_SECONDS="60"

# Tipo de cambio USD→ARS
EXCHANGE_RATE_PROVIDER="dolarapi"
EXCHANGE_RATE_FALLBACK_USD_ARS="1000"
EXCHANGE_RATE_CACHE_TTL_SECONDS="300"

# App
NODE_ENV="development"
PORT="3001"
FRONTEND_URL="http://localhost:3000"

# Logging
# Valores: trace | debug | info | warn | error | fatal
LOG_LEVEL="info"

# Sentry (opcional)
SENTRY_DSN=""

# Business Config
# Permitir stock negativo por defecto (true | false)
ALLOW_NEGATIVE_STOCK="false"

# Rate Limiting
RATE_LIMIT_WINDOW_MS="900000"
RATE_LIMIT_MAX_REQUESTS="100"
RATE_LIMIT_REFRESH_WINDOW_MS="300000"
RATE_LIMIT_REFRESH_MAX="10"

# Cookies (Seguridad)
COOKIE_DOMAIN="localhost"
COOKIE_SECURE="false"
COOKIE_SAME_SITE="strict"

# CSRF
CSRF_SECRET="your-csrf-secret-min-32-chars-change-this-in-production"
