// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// MULTI-TENANT: Business (Tenant)
// ============================================================================

model Business {
  id        String   @id @default(cuid())
  name      String
  cuit      String   @unique
  address   String?
  phone     String?
  email     String?
  logoUrl   String?
  logoPublicId String?
  
  // Configuración fiscal
  taxCondition String  // RESPONSABLE_INSCRIPTO, MONOTRIBUTO, EXENTO
  iibbNumber   String? // Ingresos Brutos
  startDate    DateTime @default(now())
  
  // Configuración facturación
  invoiceProvider     String  @default("mock") // mock, facturante, arca_direct
  invoicePointOfSale  Int     @default(1)
  
  // Configuración negocio
  allowNegativeStock  Boolean @default(false)
  currency            String  @default("ARS")
  timezone            String  @default("America/Buenos_Aires") // IANA timezone
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  // Relaciones
  users               User[]
  roles               Role[]
  products            Product[]
  categories          Category[]
  brands              Brand[]
  suppliers           Supplier[]
  purchases           Purchase[]
  inventoryMovements  InventoryMovement[]
  sales               Sale[]
  saleRefunds         SaleRefund[]
  cashRegisterSessions CashRegisterSession[]
  customers           Customer[]
  invoices            Invoice[]
  invoiceJobs         InvoiceJob[]
  auditLogs           AuditLog[]
  idempotencyKeys     IdempotencyKey[]
  exchangeRateSnapshots ExchangeRateSnapshot[]
  exchangeRateConfig  ExchangeRateConfig?
  refreshTokenSessions RefreshTokenSession[]
  arcaCredential      BusinessArcaCredential?
  discountApprovals   DiscountApproval[]
  priceHistories      PriceHistory[]
  priceSuggestions    PriceSuggestion[]
  cashMovements       CashMovement[]
  accountMovements    AccountMovement[]
  supplierPayables    SupplierPayable[]
  supplierPayments    SupplierPayment[]
  financialAccounts   FinancialAccount[]
  financialMovements  FinancialMovement[]
  checkRegisters      CheckRegister[]
  
  @@map("businesses")
}

// ============================================================================
// AUTH & RBAC
// ============================================================================

model User {
  id         String   @id @default(cuid())
  businessId String
  email      String   @unique
  username   String?  @unique
  password   String   // argon2 hash
  firstName  String?
  lastName   String?
  isActive   Boolean  @default(true)
  
  // Reset password
  resetToken       String?   @unique
  resetTokenExpiry DateTime?
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  // Relaciones
  business             Business              @relation(fields: [businessId], references: [id], onDelete: Cascade)
  roles                UserRole[]
  cashRegisterSessions CashRegisterSession[]
  auditLogs            AuditLog[]
  refreshTokenSessions RefreshTokenSession[]
  discountApprovalsRequested DiscountApproval[] @relation("DiscountApprovalRequestedBy")
  discountApprovalsApproved  DiscountApproval[] @relation("DiscountApprovalApprovedBy")
  discountApprovalsRejected  DiscountApproval[] @relation("DiscountApprovalRejectedBy")
  inventoryMovements   InventoryMovement[]
  
  @@index([businessId])
  @@index([email])
  @@map("users")
}

model Role {
  id          String   @id @default(cuid())
  businessId  String
  name        String   // OWNER, ADMIN, CASHIER, STOCKER, MANAGER
  description String?
  isSystem    Boolean  @default(false) // Roles del sistema no se pueden eliminar
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  // Relaciones
  business    Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  users       UserRole[]
  permissions RolePermission[]
  
  @@unique([businessId, name])
  @@index([businessId])
  @@map("roles")
}

model Permission {
  id          String   @id @default(cuid())
  resource    String   // products, sales, inventory, etc.
  action      String   // create, read, update, delete, manage
  description String?
  
  createdAt DateTime @default(now())
  
  // Relaciones
  roles RolePermission[]
  
  @@unique([resource, action])
  @@map("permissions")
}

model UserRole {
  id     String @id @default(cuid())
  userId String
  roleId String
  
  assignedAt DateTime @default(now())
  
  // Relaciones
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)
  
  @@unique([userId, roleId])
  @@index([userId])
  @@index([roleId])
  @@map("user_roles")
}

model RolePermission {
  id           String @id @default(cuid())
  roleId       String
  permissionId String
  
  grantedAt DateTime @default(now())
  
  // Relaciones
  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  
  @@unique([roleId, permissionId])
  @@index([roleId])
  @@map("role_permissions")
}

// ============================================================================
// REFRESH TOKEN SESSIONS (Security)
// ============================================================================

model RefreshTokenSession {
  id              String   @id @default(cuid())
  userId          String
  businessId      String
  tokenFamily     String   // UUID que agrupa tokens rotados de la misma sesión
  tokenHash       String   @unique // Hash SHA-256 del refresh token
  isRevoked       Boolean  @default(false)
  reuseDetected   Boolean  @default(false) // Si se detecta reuso, marca toda la familia
  expiresAt       DateTime
  createdAt       DateTime @default(now())
  lastUsedAt      DateTime @default(now())
  ipAddress       String?
  userAgent       String?
  
  // Relaciones
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  
  @@index([userId])
  @@index([businessId])
  @@index([tokenFamily])
  @@index([tokenHash])
  @@index([expiresAt])
  @@map("refresh_token_sessions")
}

// ============================================================================
// PRODUCTS
// ============================================================================

model Category {
  id          String  @id @default(cuid())
  businessId  String
  name        String
  description String?
  parentId    String? // Para categorías anidadas
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  // Relaciones
  business Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  parent   Category? @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children Category[] @relation("CategoryHierarchy")
  products Product[]
  
  @@unique([businessId, name])
  @@index([businessId])
  @@map("categories")
}

model Brand {
  id          String  @id @default(cuid())
  businessId  String
  name        String
  description String?
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  // Relaciones
  business Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  products Product[]
  
  @@unique([businessId, name])
  @@index([businessId])
  @@map("brands")
}

model Product {
  id           String   @id @default(cuid())
  businessId   String
  internalSku  String   @unique // Auto-generado: FER-00001
  barcode      String?  @unique // Código de barras (opcional)
  name         String
  description  String?
  categoryId   String?
  brandId      String?
  
  // Unidad de medida: u (unidad), mt (metro), kg (kilogramo), lt (litro)
  unit         String   @default("u")
  isFractional Boolean  @default(false) // Permite decimales en cantidad
  
  // Precios e impuestos
  cost           Decimal  @db.Decimal(12, 2)
  price          Decimal  @db.Decimal(12, 2)
  taxRate        Decimal  @db.Decimal(5, 2) @default(21.00) // IVA %
  marginPercent  Decimal? @db.Decimal(5, 2) // Margen de ganancia %
  suggestedPrice Decimal? @db.Decimal(12, 2) // Precio sugerido calculado
  
  // Configuración de pricing automático
  pricingMode    String?  @default("margin") // fixed, margin, markup, suggest
  targetMargin   Decimal? @db.Decimal(5, 2)  // Margen objetivo %
  targetMarkup   Decimal? @db.Decimal(5, 2)  // Markup objetivo %
  priceLocked    Boolean  @default(false)     // Precio congelado (no permite cambios automáticos)
  roundingStep   Int      @default(10)        // Redondeo de precio (10, 50, 100)
  costMethod     String   @default("avg_weighted") // avg_weighted, last_cost
  
  // Stock
  stockQuantity Decimal  @db.Decimal(12, 3) @default(0)
  minStock      Decimal? @db.Decimal(12, 3)
  
  // Variantes (self-relation)
  parentId     String?
  variantName  String? // Ej: "Talle L", "Pack x12"
  
  imageUrl       String?  // URL pública de Cloudinary
  imagePublicId  String?  // ID público de Cloudinary para eliminar después
  
  isActive     Boolean  @default(true)
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  // Relaciones
  business           Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  category           Category?           @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  brand              Brand?              @relation(fields: [brandId], references: [id], onDelete: SetNull)
  parent             Product?            @relation("ProductVariants", fields: [parentId], references: [id])
  variants           Product[]           @relation("ProductVariants")
  priceHistory       PriceHistory[]
  priceSuggestions   PriceSuggestion[]
  inventoryMovements InventoryMovement[]
  purchaseItems      PurchaseItem[]
  saleItems          SaleItem[]
  saleRefundItems    SaleRefundItem[]
  discountApprovals  DiscountApproval[]
  
  @@index([businessId])
  @@index([barcode])
  @@index([internalSku])
  @@index([categoryId])
  @@index([brandId])
  @@map("products")
}

model PriceHistory {
  id         String  @id @default(cuid())
  businessId String
  productId  String
  purchaseId String? // Referencia a la compra que originó el cambio
  
  oldCost    Decimal  @db.Decimal(12, 2)
  newCost    Decimal  @db.Decimal(12, 2)
  oldPrice   Decimal  @db.Decimal(12, 2)
  newPrice   Decimal  @db.Decimal(12, 2)
  oldMargin  Decimal? @db.Decimal(5, 2) // Margen anterior %
  newMargin  Decimal? @db.Decimal(5, 2) // Margen nuevo %
  
  reason     String? // purchase, manual_adjustment, approved_suggestion
  changedBy  String? // userId
  
  createdAt DateTime @default(now())
  
  // Relaciones
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  
  @@index([businessId])
  @@index([productId])
  @@index([purchaseId])
  @@map("price_history")
}

model PriceSuggestion {
  id          String  @id @default(cuid())
  businessId  String
  productId   String
  purchaseId  String? // Compra que originó la sugerencia
  
  oldCost     Decimal @db.Decimal(12, 2)
  newCost     Decimal @db.Decimal(12, 2)
  oldPrice    Decimal @db.Decimal(12, 2)
  suggestedPrice Decimal @db.Decimal(12, 2)
  oldMargin   Decimal @db.Decimal(5, 2)
  newMargin   Decimal @db.Decimal(5, 2)
  
  pricingMode String  // Modo usado para calcular (margin, markup)
  reason      String? // Motivo de la sugerencia
  
  status      String  @default("PENDING") // PENDING, APPROVED, REJECTED
  
  requestedBy String  // userId que originó (ej: quien hizo la compra)
  requestedAt DateTime @default(now())
  
  approvedBy  String? // userId con permiso pricing:approve
  approvedAt  DateTime?
  
  rejectedBy  String?
  rejectedAt  DateTime?
  rejectionReason String?
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  // Relaciones
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  purchase Purchase? @relation(fields: [purchaseId], references: [id], onDelete: SetNull)
  
  @@index([businessId])
  @@index([productId])
  @@index([purchaseId])
  @@index([status])
  @@index([requestedAt])
  @@map("price_suggestions")
}

// ============================================================================
// INVENTORY
// ============================================================================

model InventoryMovement {
  id          String  @id @default(cuid())
  businessId  String
  productId   String
  type        String  // INITIAL_STOCK, PURCHASE_RECEIPT, SALE, RETURN, STOCK_ADJUSTMENT, TRANSFER
  quantity    Decimal @db.Decimal(12, 3) // Puede ser negativo (salida)
  
  // Metadata
  reason      String?
  referenceId String? // ID de la venta, compra, etc.
  userId      String?
  
  createdAt DateTime @default(now())
  
  // Relaciones
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  user     User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  
  @@index([businessId])
  @@index([productId])
  @@index([type])
  @@index([createdAt])
  @@map("inventory_movements")
}

// ============================================================================
// SUPPLIERS & PURCHASES
// ============================================================================

model Supplier {
  id          String  @id @default(cuid())
  businessId  String
  name        String
  cuit        String?
  email       String?
  phone       String?
  address     String?
  
  // Condiciones comerciales
  paymentTermDays Int @default(0) // Plazo de pago en días (0 = contado)
  paymentMethods String? // JSON: ["CASH", "TRANSFER", "CHECK"]
  creditLimit Decimal? @db.Decimal(12, 2)
  currentBalance Decimal @db.Decimal(12, 2) @default(0) // Saldo adeudado
  
  // Contactos secundarios
  contactName String?
  contactPhone String?
  
  isActive    Boolean @default(true)
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  // Relaciones
  business  Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  purchases Purchase[]
  payables SupplierPayable[]
  
  @@index([businessId])
  @@map("suppliers")
}

model Purchase {
  id          String   @id @default(cuid())
  businessId  String
  supplierId  String
  invoiceNumber String?
  status      String   @default("CONFIRMED") // PENDING, PARTIAL, PAID, CONFIRMED, CANCELLED
  
  subtotal    Decimal  @db.Decimal(12, 2)
  tax         Decimal  @db.Decimal(12, 2)
  total       Decimal  @db.Decimal(12, 2)
  amountPaid  Decimal  @db.Decimal(12, 2) @default(0)
  payableId   String?
  
  // Soporte multi-moneda
  currency       String  @default("ARS") // ARS o USD
  exchangeRateId String? // Si fue en USD
  
  notes       String?
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  // Relaciones
  business Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  supplier Supplier       @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  items    PurchaseItem[]
  attachments PurchaseAttachment[]
  payables SupplierPayable[]
  priceSuggestions PriceSuggestion[]
  exchangeRate ExchangeRateSnapshot? @relation(fields: [exchangeRateId], references: [id])
  
  @@index([businessId])
  @@index([supplierId])
  @@map("purchases")
}

model PurchaseItem {
  id         String  @id @default(cuid())
  purchaseId String
  productId  String
  quantity   Decimal @db.Decimal(12, 3)
  unitCost   Decimal @db.Decimal(12, 2)
  taxRate    Decimal @db.Decimal(5, 2)
  subtotal   Decimal @db.Decimal(12, 2)
  
  createdAt DateTime @default(now())
  
  // Relaciones
  purchase Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  
  @@index([purchaseId])
  @@index([productId])
  @@map("purchase_items")
}

model PurchaseAttachment {
  id         String  @id @default(cuid())
  purchaseId String
  fileName   String
  fileUrl    String
  fileType   String  // "INVOICE", "RECEIPT", "NOTE"
  fileSize   Int
  
  uploadedBy String
  uploadedAt DateTime @default(now())
  
  // Relaciones
  purchase Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  
  @@index([purchaseId])
  @@map("purchase_attachments")
}

model SupplierPayable {
  id         String  @id @default(cuid())
  businessId String
  supplierId String
  purchaseId String?
  
  amount     Decimal @db.Decimal(12, 2)
  paidAmount Decimal @db.Decimal(12, 2) @default(0)
  
  // Soporte multi-moneda
  currency   String  @default("ARS") // ARS o USD
  
  dueDate    DateTime?
  status     String  @default("PENDING") // PENDING, PARTIAL, PAID, OVERDUE, CANCELLED
  
  notes      String?
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  // Relaciones
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  purchase Purchase? @relation(fields: [purchaseId], references: [id], onDelete: SetNull)
  payments SupplierPayment[]
  checkRegisters CheckRegister[]
  
  @@index([businessId])
  @@index([supplierId])
  @@index([status])
  @@index([dueDate])
  @@map("supplier_payables")
}

model SupplierPayment {
  id         String  @id @default(cuid())
  businessId String
  payableId  String
  
  amount     Decimal @db.Decimal(12, 2)
  method     String  // CASH, TRANSFER, CHECK, CARD
  reference  String? // Número de cheque, referencia de transferencia
  
  // Soporte multi-moneda
  currency       String  @default("ARS")
  amountUSD      Decimal? @db.Decimal(12, 2)
  exchangeRateId String?
  
  paidAt     DateTime @default(now())
  recordedBy String  // userId
  
  notes      String?
  
  createdAt DateTime @default(now())
  
  // Relaciones
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  payable  SupplierPayable @relation(fields: [payableId], references: [id], onDelete: Cascade)
  exchangeRate ExchangeRateSnapshot? @relation(fields: [exchangeRateId], references: [id])
  checkRegister CheckRegister?
  
  @@index([businessId])
  @@index([payableId])
  @@map("supplier_payments")
}

model CheckRegister {
  id              String    @id @default(cuid())
  businessId      String
  accountId       String    // Cuenta bancaria de la cual se emite el cheque
  
  checkNumber     String    // Número de cheque
  amount          Decimal   @db.Decimal(12, 2)
  currency        String    @default("ARS")
  
  // Referencia al pago
  payableId       String?   // Referencia a SupplierPayable (si es pago a proveedor)
  paymentId       String?   @unique // Referencia a SupplierPayment
  
  // Estado del cheque
  status          String    @default("ISSUED") // ISSUED, CLEARED, BOUNCED, CANCELLED
  
  // Fechas
  issuedAt        DateTime  @default(now())
  clearedAt       DateTime? // Cuando se cobró el cheque
  bouncedAt       DateTime? // Si rebotó
  cancelledAt     DateTime? // Si se canceló
  
  // Información adicional
  recipientName   String?   // A nombre de quién está el cheque
  notes           String?
  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  
  // Relaciones
  business        Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  account         FinancialAccount  @relation(fields: [accountId], references: [id], onDelete: Restrict)
  payable         SupplierPayable?  @relation(fields: [payableId], references: [id], onDelete: SetNull)
  payment         SupplierPayment?  @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  
  @@unique([businessId, checkNumber])
  @@index([businessId])
  @@index([accountId])
  @@index([status])
  @@index([payableId])
  @@map("check_register")
}

// ============================================================================
// SALES & POS
// ============================================================================

model Sale {
  id            String   @id @default(cuid())
  businessId    String
  customerId    String?
  userId        String?  // Cajero
  cashRegisterId String? // Sesión de caja
  
  status        String   @default("DRAFT") // DRAFT, CONFIRMED, CANCELLED
  invoiceStatus String   @default("PENDING_INVOICE") // PENDING_INVOICE, INVOICED, FAILED
  
  // Totales
  subtotal      Decimal  @db.Decimal(12, 2)
  discountAmount Decimal @db.Decimal(12, 2) @default(0)
  taxAmount     Decimal  @db.Decimal(12, 2)
  total         Decimal  @db.Decimal(12, 2)
  
  // Offline sync
  clientOperationId String? @unique
  
  notes         String?
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  confirmedAt DateTime?
  
  // Relaciones
  business       Business             @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer       Customer?            @relation(fields: [customerId], references: [id], onDelete: SetNull)
  cashRegister   CashRegisterSession? @relation(fields: [cashRegisterId], references: [id], onDelete: SetNull)
  items          SaleItem[]
  payments       Payment[]
  refunds        SaleRefund[]
  invoices       Invoice[]
  invoiceJobs    InvoiceJob[]
  
  @@index([businessId])
  @@index([customerId])
  @@index([status])
  @@index([createdAt])
  @@index([clientOperationId])
  @@map("sales")
}

model SaleItem {
  id              String  @id @default(cuid())
  saleId          String
  productId       String
  quantity        Decimal @db.Decimal(12, 3)
  unitPrice       Decimal @db.Decimal(12, 2)
  taxRate         Decimal @db.Decimal(5, 2)
  discountAmount  Decimal @db.Decimal(12, 2) @default(0)
  discountPercent Decimal @db.Decimal(5, 2) @default(0)
  subtotal        Decimal @db.Decimal(12, 2)
  
  // Descuentos a ojo
  discountedPrice Decimal? @db.Decimal(12, 2) // Precio final con descuento
  discountReason  String?  // Motivo del descuento (ej: "Descuento familiar")
  discountApprovedBy String? // userId de quien aprobó el descuento
  discountApprovedAt DateTime? // Timestamp de aprobación
  
  createdAt DateTime @default(now())
  
  // Relaciones
  sale    Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  discountApproval DiscountApproval? // Relación con solicitud de aprobación
  refundItems SaleRefundItem[]
  
  @@index([saleId])
  @@index([productId])
  @@map("sale_items")
}

model DiscountApproval {
  id              String  @id @default(cuid())
  businessId      String
  saleItemId      String  @unique // Relación 1:1 con SaleItem
  productId       String
  
  originalPrice   Decimal @db.Decimal(12, 2)
  discountedPrice Decimal @db.Decimal(12, 2)
  discountReason  String
  
  requestedBy     String  // userId de quien solicitó
  requestedAt     DateTime @default(now())
  
  status          String  @default("PENDING") // PENDING, APPROVED, REJECTED, EXPIRED
  
  approvedBy      String? // userId de quien aprobó
  approvedAt      DateTime?
  
  rejectionReason String? // Motivo del rechazo
  rejectedBy      String? // userId de quien rechazó
  rejectedAt      DateTime?
  
  expiresAt       DateTime // Timestamp de expiración (5 minutos)
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  // Relaciones
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  saleItem SaleItem @relation(fields: [saleItemId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  requestedByUser User @relation("DiscountApprovalRequestedBy", fields: [requestedBy], references: [id], onDelete: Restrict)
  approvedByUser  User? @relation("DiscountApprovalApprovedBy", fields: [approvedBy], references: [id], onDelete: SetNull)
  rejectedByUser  User? @relation("DiscountApprovalRejectedBy", fields: [rejectedBy], references: [id], onDelete: SetNull)
  
  @@index([businessId])
  @@index([status])
  @@index([expiresAt])
  @@index([requestedBy])
  @@map("discount_approvals")
}

model Payment {
  id     String  @id @default(cuid())
  saleId String
  method String  // CASH_ARS, CASH_USD, CARD, TRANSFER, QR
  amount Decimal @db.Decimal(12, 2)
  
  // Para pagos en USD
  exchangeRateId String?
  amountUSD      Decimal? @db.Decimal(12, 2)
  
  // Para tarjetas
  cardBrand      String? // VISA, MASTERCARD, etc.
  financialCost  Decimal? @db.Decimal(12, 2) @default(0)
  
  notes String?
  
  createdAt DateTime @default(now())
  
  // Relaciones
  sale         Sale                  @relation(fields: [saleId], references: [id], onDelete: Cascade)
  exchangeRate ExchangeRateSnapshot? @relation(fields: [exchangeRateId], references: [id])
  
  @@index([saleId])
  @@map("payments")
}

model SaleRefund {
  id          String   @id @default(cuid())
  businessId  String
  saleId      String
  reason      String?
  status      String   @default("COMPLETED") // COMPLETED, CANCELLED
  subtotal    Decimal  @db.Decimal(12, 2)
  total       Decimal  @db.Decimal(12, 2)
  defaultPayout Json?
  appliedPayout Json?
  notes       String?
  clientOperationId String?
  createdAt   DateTime @default(now())
  createdBy   String?

  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  sale        Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  items       SaleRefundItem[]
  payments    SaleRefundPayment[]

  @@index([businessId])
  @@index([saleId])
  @@index([createdAt])
  @@index([clientOperationId])
  @@map("sale_refunds")
}

model SaleRefundItem {
  id            String   @id @default(cuid())
  saleRefundId  String
  saleItemId    String
  productId     String
  quantity      Decimal  @db.Decimal(12, 3)
  unitPrice     Decimal  @db.Decimal(12, 2)
  amount        Decimal  @db.Decimal(12, 2)
  createdAt     DateTime @default(now())

  saleRefund    SaleRefund @relation(fields: [saleRefundId], references: [id], onDelete: Cascade)
  saleItem      SaleItem   @relation(fields: [saleItemId], references: [id], onDelete: Restrict)
  product       Product    @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([saleRefundId])
  @@index([saleItemId])
  @@index([productId])
  @@map("sale_refund_items")
}

model SaleRefundPayment {
  id            String   @id @default(cuid())
  saleRefundId  String
  method        String
  amount        Decimal  @db.Decimal(12, 2)
  notes         String?
  createdAt     DateTime @default(now())

  saleRefund    SaleRefund @relation(fields: [saleRefundId], references: [id], onDelete: Cascade)

  @@index([saleRefundId])
  @@index([method])
  @@map("sale_refund_payments")
}

// ============================================================================
// CASH REGISTER
// ============================================================================

model CashRegisterSession {
  id          String   @id @default(cuid())
  businessId  String
  userId      String
  status      String   @default("OPEN") // OPEN, CLOSED
  
  openingAmount Decimal @db.Decimal(12, 2)
  closingAmount Decimal? @db.Decimal(12, 2)
  expectedAmount Decimal? @db.Decimal(12, 2)
  difference    Decimal? @db.Decimal(12, 2)
  
  // Soporte USD en caja
  openingAmountUSD  Decimal? @db.Decimal(12, 2)
  closingAmountUSD  Decimal? @db.Decimal(12, 2)
  expectedAmountUSD Decimal? @db.Decimal(12, 2)
  differenceUSD     Decimal? @db.Decimal(12, 2)
  
  // Snapshots de cotización
  openingExchangeRateId String?
  closingExchangeRateId String?
  
  openedAt  DateTime @default(now())
  closedAt  DateTime?
  
  notes String?
  
  // Relaciones
  business Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user     User           @relation(fields: [userId], references: [id], onDelete: Restrict)
  sales    Sale[]
  movements CashMovement[]
  openingExchangeRate ExchangeRateSnapshot? @relation("OpeningRate", fields: [openingExchangeRateId], references: [id])
  closingExchangeRate ExchangeRateSnapshot? @relation("ClosingRate", fields: [closingExchangeRateId], references: [id])
  
  @@index([businessId])
  @@index([userId])
  @@index([status])
  @@map("cash_register_sessions")
}

model CashMovement {
  id               String  @id @default(cuid())
  businessId       String
  cashRegisterId   String
  type             String  // INCOME, EXPENSE
  amount           Decimal @db.Decimal(12, 2)
  reason           String
  approvedBy       String? // userId de quien aprobó
  
  createdAt DateTime @default(now())
  
  // Relaciones
  business     Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  cashRegister CashRegisterSession @relation(fields: [cashRegisterId], references: [id], onDelete: Cascade)
  
  @@index([businessId])
  @@index([cashRegisterId])
  @@map("cash_movements")
}

// ============================================================================
// CUSTOMERS & ACCOUNT
// ============================================================================

model Customer {
  id          String  @id @default(cuid())
  businessId  String
  type        String  @default("PERSON") // PERSON, COMPANY
  
  // Persona
  firstName   String?
  lastName    String?
  
  // Empresa
  companyName String?
  cuit        String?
  taxCondition String  @default("CONSUMIDOR_FINAL") // RESPONSABLE_INSCRIPTO, MONOTRIBUTO, EXENTO, CONSUMIDOR_FINAL, NO_CATEGORIZADO, IVA_NO_ALCANZADO
  
  email       String?
  phone       String?
  address     String?
  
  // Cuenta corriente
  creditLimit Decimal? @db.Decimal(12, 2)
  currentBalance Decimal @db.Decimal(12, 2) @default(0)
  
  isActive    Boolean @default(true)
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  // Relaciones
  business        Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  sales           Sale[]
  accountMovements AccountMovement[]
  
  @@index([businessId])
  @@index([email])
  @@map("customers")
}

model AccountMovement {
  id         String  @id @default(cuid())
  businessId String
  customerId String
  type       String  // SALE, PAYMENT, ADJUSTMENT
  amount     Decimal @db.Decimal(12, 2) // Positivo = deuda, Negativo = pago
  balance    Decimal @db.Decimal(12, 2) // Balance después del movimiento
  
  referenceId String? // ID de venta o pago
  notes       String?
  
  createdAt DateTime @default(now())
  
  // Relaciones
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  
  @@index([businessId])
  @@index([customerId])
  @@index([createdAt])
  @@map("account_movements")
}

// ============================================================================
// INVOICING (ARCA/AFIP)
// ============================================================================

model Invoice {
  id          String  @id @default(cuid())
  businessId  String
  saleId      String
  
  provider    String  // mock, facturante, arca_direct
  voucherType String  // A, B, C, NC_A, NC_B, NC_C, ND_A, ND_B, ND_C

  relatedInvoiceId String?
  adjustmentKind   String? // CREDIT_NOTE, DEBIT_NOTE
  adjustmentReason String? @db.Text
  
  // Datos ARCA
  cae         String?
  caeExpiry   DateTime?
  pointOfSale Int?
  number      Int?
  qrData      String?  @db.Text
  
  // URLs
  pdfUrl      String?
  xmlUrl      String?
  
  status      String  @default("PENDING") // PENDING, ISSUED, FAILED
  errorMessage String? @db.Text
  
  // Request/Response para auditoría
  requestPayload  String? @db.Text
  responsePayload String? @db.Text
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  issuedAt  DateTime?
  
  // Relaciones
  business       Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  sale           Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  relatedInvoice Invoice? @relation("InvoiceAdjustment", fields: [relatedInvoiceId], references: [id], onDelete: SetNull)
  adjustments    Invoice[] @relation("InvoiceAdjustment")

  @@index([businessId])
  @@index([saleId])
  @@index([status])
  @@unique([saleId, voucherType])
  @@map("invoices")
}

model BusinessArcaCredential {
  id         String @id @default(cuid())
  businessId String @unique

  cuit                  String
  environment           String   @default("homo") // homo | prod
  wsfeUrl               String?
  wsaaUrl               String?
  serviceName           String   @default("wsfe")
  isEnabled             Boolean  @default(true)

  tokenEncrypted        String?  @db.Text
  signEncrypted         String?  @db.Text
  tokenExpiresAt        DateTime?

  certificatePemEncrypted String? @db.Text
  privateKeyPemEncrypted  String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([isEnabled])
  @@map("business_arca_credentials")
}

model InvoiceJob {
  id          String   @id @default(cuid())
  businessId  String
  saleId      String
  voucherType String   // A, B, C, NC_A, NC_B, NC_C, ND_A, ND_B, ND_C

  status      String   @default("PENDING") // PENDING, PROCESSING, RETRYING, COMPLETED, FAILED
  attempts    Int      @default(0)
  maxAttempts Int      @default(8)
  nextRetryAt DateTime @default(now())
  lockedAt    DateTime?
  processedAt DateTime?
  lastError   String?  @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  sale     Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@unique([saleId, voucherType])
  @@index([businessId])
  @@index([status, nextRetryAt])
  @@map("invoice_jobs")
}

// ============================================================================
// EXCHANGE RATE
// ============================================================================

model ExchangeRateSnapshot {
  id       String  @id @default(cuid())
  businessId String
  
  fromCurrency String @default("USD")
  toCurrency   String @default("ARS")
  rate         Decimal @db.Decimal(12, 4)
  
  // Nuevos campos
  dollarType   String  @default("oficial") // oficial, blue, tarjeta, mep, ccl, cripto
  buyRate      Decimal? @db.Decimal(12, 4) // Precio de compra
  sellRate     Decimal? @db.Decimal(12, 4) // Precio de venta
  
  source    String  // argentinadatos, manual, etc.
  
  createdAt DateTime @default(now())
  
  // Relaciones
  business Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  payments Payment[]
  purchases Purchase[]
  supplierPayments SupplierPayment[]
  cashRegisterOpenings CashRegisterSession[] @relation("OpeningRate")
  cashRegisterClosings CashRegisterSession[] @relation("ClosingRate")
  
  @@index([businessId])
  @@index([createdAt])
  @@map("exchange_rate_snapshots")
}

// ============================================================================
// EXCHANGE RATE CONFIG
// ============================================================================

model ExchangeRateConfig {
  id          String   @id @default(cuid())
  businessId  String   @unique
  
  // Habilitar/deshabilitar USD globalmente
  usdEnabled  Boolean  @default(false)
  
  // Tipo de dólar: oficial, blue, tarjeta, mep, ccl, cripto
  dollarType  String   @default("oficial")
  
  // Margen adicional sobre cotización (%)
  marginPercent Decimal @db.Decimal(5, 2) @default(0)
  
  // Actualización automática
  autoUpdate  Boolean  @default(true)
  updateIntervalMinutes Int @default(30)
  
  // Cotización manual (fallback)
  manualRate  Decimal? @db.Decimal(12, 4)
  useManualRate Boolean @default(false)
  
  // Última actualización
  lastUpdated DateTime @default(now())
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  // Relaciones
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  
  @@map("exchange_rate_configs")
}

// ============================================================================
// AUDIT & IDEMPOTENCY
// ============================================================================

model AuditLog {
  id         String  @id @default(cuid())
  businessId String
  userId     String?
  action     String  // CREATE, UPDATE, DELETE, LOGIN, etc.
  entity     String  // products, sales, users, etc.
  entityId   String?
  
  before     Json?
  after      Json?
  
  ip         String?
  userAgent  String?
  
  createdAt DateTime @default(now())
  
  // Relaciones
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user     User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  
  @@index([businessId])
  @@index([userId])
  @@index([entity])
  @@index([createdAt])
  @@map("audit_logs")
}

model IdempotencyKey {
  id                String @id @default(cuid())
  businessId        String
  clientOperationId String @unique
  endpoint          String
  
  responseStatus    Int
  responseBody      Json
  
  createdAt DateTime @default(now())
  expiresAt DateTime // TTL: 24-48h
  
  // Relaciones
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  
  @@index([businessId])
  @@index([clientOperationId])
  @@index([expiresAt])
  @@map("idempotency_keys")
}

// ============================================================================
// FINANCIAL ACCOUNTS (Cuentas Financieras)
// ============================================================================

model FinancialAccount {
  id          String   @id @default(cuid())
  businessId  String
  
  type        String   // CASH, BANK, WALLET, CREDIT_CARD
  name        String   // "Caja Principal", "Banco Nación Cta 123", "MercadoPago"
  description String?
  currency    String   @default("ARS")
  
  // Balance actual (calculado en tiempo real)
  balance     Decimal  @db.Decimal(12, 2) @default(0)
  
  // Configuración
  isDefault   Boolean  @default(false) // Cuenta por defecto para cada tipo
  isActive    Boolean  @default(true)
  
  // Metadata específica por tipo
  bankName      String?  // Para BANK
  accountNumber String?  // Para BANK
  walletProvider String? // Para WALLET (mercadopago, ualá, etc.)
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  // Relaciones
  business      Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  movements     FinancialMovement[] @relation("AccountMovements")
  transfersFrom FinancialMovement[] @relation("TransferFrom")
  transfersTo   FinancialMovement[] @relation("TransferTo")
  checkRegisters CheckRegister[]
  
  @@unique([businessId, name])
  @@index([businessId])
  @@index([type])
  @@index([isActive])
  @@map("financial_accounts")
}

model FinancialMovement {
  id          String   @id @default(cuid())
  businessId  String
  accountId   String   // Cuenta afectada
  
  type        String   // INCOME, EXPENSE, TRANSFER
  amount      Decimal  @db.Decimal(12, 2) // Siempre positivo
  
  // Para transferencias entre cuentas
  transferFromAccountId String? // Cuenta origen (si es transferencia)
  transferToAccountId   String? // Cuenta destino (si es transferencia)
  
  // Referencia a la transacción que originó el movimiento
  sourceType  String?  // SALE, PURCHASE_PAYMENT, CASH_REGISTER_OPEN, SUPPLIER_PAYMENT, MANUAL, etc.
  sourceId    String?  // ID de la venta, compra, pago, etc.
  
  description String?
  notes       String?
  
  // Balance después del movimiento (snapshot para auditoría)
  balanceAfter Decimal @db.Decimal(12, 2)
  
  createdAt   DateTime @default(now())
  createdBy   String?  // userId
  
  // Relaciones
  business     Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  account      FinancialAccount @relation("AccountMovements", fields: [accountId], references: [id], onDelete: Restrict)
  transferFrom FinancialAccount? @relation("TransferFrom", fields: [transferFromAccountId], references: [id], onDelete: SetNull)
  transferTo   FinancialAccount? @relation("TransferTo", fields: [transferToAccountId], references: [id], onDelete: SetNull)
  
  @@index([businessId])
  @@index([accountId])
  @@index([sourceType, sourceId])
  @@index([createdAt])
  @@index([type])
  @@map("financial_movements")
}
