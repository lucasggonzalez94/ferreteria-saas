{
  "eslint.enable": true,
  "eslint.validate": [
    "typescript",
    "typescriptreact"
  ],
  "eslint.workingDirectories": [
    { "directory": "./ferresaas-api", "changeDetection": false },
    { "directory": "./ferresaas-web", "changeDetection": false }
  ],
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "explicit"
  },
  "typescript.preferences.includePackageJsonAutoImports": "on",
  "editor.formatOnSave": false,
  "files.eol": "\n"
}